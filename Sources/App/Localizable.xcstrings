    "This device couldn't run the cleanup model, so these are your words exactly as they were heard." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät konnte das Aufbereitungsmodell nicht ausführen – das sind deine Worte genau so, wie sie gehört wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This device couldn't run the cleanup model, so these are your words exactly as they were heard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no pudo ejecutar el modelo de limpieza, así que estas son tus palabras tal como se escucharon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n'a pas pu exécuter le modèle de nettoyage : voici donc vos mots exactement tels qu'ils ont été entendus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non è riuscito a eseguire il modello di pulizia, quindi queste sono le tue parole esattamente come sono state sentite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは整形モデルを実行できなかったため、聞き取られたままの言葉を表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 정리 모델을 실행할 수 없어, 들린 그대로의 내용을 보여줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não conseguiu executar o modelo de organização, então estas são suas palavras exatamente como foram ouvidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве не удалось запустить модель обработки, поэтому здесь ваши слова ровно так, как они были услышаны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法运行整理模型，因此这些是你所说内容的原样记录。"
          }
        }
      }
    },
    "This link is queued. Open Transcription Studio on your Mac to transcribe it — the result syncs back here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link wartet in der Warteschlange. Öffne Transcription Studio auf deinem Mac, um ihn zu transkribieren — das Ergebnis wird zurück hierher synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

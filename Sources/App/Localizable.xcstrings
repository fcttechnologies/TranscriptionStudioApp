    },
    "Nothing is added until you tap Add. Transcription Studio only asks for permission to add — never to read your calendar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts hinzugefügt, bis du auf „Hinzufügen“ tippst. Transcription Studio bittet nur um die Berechtigung zum Hinzufügen — niemals darum, deinen Kalender zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se añade nada hasta que toques Añadir. Transcription Studio solo pide permiso para añadir — nunca para leer tu calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'est ajouté tant que vous n'appuyez pas sur Ajouter. Transcription Studio demande uniquement la permission d'ajouter — jamais de lire votre calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente viene aggiunto finché non tocchi Aggiungi. Transcription Studio chiede il permesso solo per aggiungere — mai per leggere il tuo calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「追加」をタップするまで何も追加されません。Transcription Studioが求めるのは追加の権限のみで、カレンダーを読み取る権限を求めることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"추가\"를 탭하기 전까지는 아무것도 추가되지 않습니다. Transcription Studio는 추가 권한만 요청하며, 캘린더를 읽는 권한은 절대 요청하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é adicionado até você tocar em Adicionar. O Transcription Studio só pede permissão para adicionar — nunca para ler seu calendário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не добавляется, пока вы не нажмёте «Добавить». Transcription Studio запрашивает разрешение только на добавление — но не на чтение вашего календаря."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您点按“添加”之前，不会添加任何内容。Transcription Studio 仅会请求添加权限，绝不会请求读取您日历的权限。"
          }
        }
      }
    },

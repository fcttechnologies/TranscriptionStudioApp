    "%lld" : {
      "shouldTranslate" : false
    },
    "%lld change(s) hadn't reached the server, so this device kept its library at sign-out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Änderung(en) haben den Server nicht erreicht, daher hat dieses Gerät seine Bibliothek bei der Abmeldung behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cambio(s) no llegaron al servidor, así que este dispositivo conservó su biblioteca al cerrar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld changement(s) n'ont pas atteint le serveur, cet appareil a donc conservé sa bibliothèque lors de la déconnexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld modifica(che) non hanno raggiunto il server, quindi questo dispositivo ha mantenuto la libreria all'uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の変更がサーバーに反映されていなかったため、サインアウト時にこのデバイスのライブラリを保持しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개의 변경 사항이 서버에 반영되지 않아 로그아웃 시 이 기기의 보관함을 유지했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld alteração(ões) não chegaram ao servidor, então este dispositivo manteve a biblioteca ao sair da conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несинхронизированных изменений: %lld — поэтому при выходе из аккаунта это устройство сохранило свою библиотеку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 项更改未同步到服务器，因此退出登录时保留了此设备上的资料库。"
          }
        }
      }
    },
    "%lld change(s) haven't reached the server. Signing out normally removes this library from this device, because your account can give it back — but these can't come back yet, so this device will keep everything instead. Stay signed in until sync finishes, or sign out and keep the library here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Änderung(en) haben den Server noch nicht erreicht. Beim Abmelden wird diese Bibliothek normalerweise von diesem Gerät entfernt, da dein Konto sie zurückgeben kann — doch diese können noch nicht zurückkommen, also behält dieses Gerät stattdessen alles. Bleib angemeldet, bis die Synchronisierung abgeschlossen ist, oder melde dich ab und behalte die Bibliothek hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cambio(s) no han llegado al servidor. Cerrar sesión normalmente elimina esta biblioteca de este dispositivo, porque tu cuenta puede devolvértela — pero estos aún no pueden volver, así que este dispositivo conservará todo en su lugar. Permanece con la sesión iniciada hasta que la sincronización termine, o cierra sesión y conserva la biblioteca aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld changement(s) n'ont pas atteint le serveur. Se déconnecter supprime normalement cette bibliothèque de cet appareil, car votre compte peut vous la redonner — mais ceux-ci ne peuvent pas encore revenir, donc cet appareil conservera tout à la place. Restez connecté jusqu'à la fin de la synchronisation, ou déconnectez-vous et conservez la bibliothèque ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld modifica(che) non hanno ancora raggiunto il server. Di norma, uscire rimuove questa libreria da questo dispositivo, perché il tuo account può restituirla — ma queste non possono ancora tornare, quindi questo dispositivo manterrà tutto. Resta connesso finché la sincronizzazione non finisce, oppure esci mantenendo la libreria qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の変更がサーバーに反映されていません。通常、サインアウトするとこのデバイスからライブラリが削除されます。アカウントに戻せば復元できるからです。ただし今回はまだ復元できないため、代わりにこのデバイスがすべてを保持します。同期が完了するまでサインインを続けるか、サインアウトしてライブラリをこの端末に残してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개의 변경 사항이 아직 서버에 반영되지 않았습니다. 평소에는 로그아웃하면 계정에서 다시 받을 수 있으므로 이 기기에서 보관함이 삭제됩니다. 하지만 이번에는 아직 복원할 수 없으므로 이 기기가 모든 항목을 대신 보관합니다. 동기화가 끝날 때까지 로그인 상태를 유지하거나, 로그아웃하고 보관함을 이 기기에 남겨두세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld alteração(ões) ainda não chegaram ao servidor. Normalmente, sair da conta remove esta biblioteca deste dispositivo, porque sua conta pode devolvê-la — mas essas ainda não podem voltar, então este dispositivo vai manter tudo em vez disso. Continue conectado até a sincronização terminar, ou saia da conta e mantenha a biblioteca aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несинхронизированных изменений: %lld. Обычно выход из аккаунта убирает эту библиотеку с устройства, ведь аккаунт может вернуть её — но эти изменения пока вернуть нельзя, поэтому устройство сохранит всё как есть. Оставайтесь в системе до конца синхронизации либо выйдите, сохранив библиотеку здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 项更改尚未同步到服务器。通常退出登录会从此设备中移除该资料库，因为您的账户可以随时恢复它——但这些更改目前还无法恢复，因此此设备将保留全部内容。请保持登录状态直至同步完成，或选择退出登录并将资料库保留在本机。"
          }
        }
      }
    },

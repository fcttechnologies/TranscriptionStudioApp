    "Watch the transcript arrive as you speak — on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh das Transkript entstehen, während du sprichst — auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve la transcripción aparecer mientras hablas — en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcription apparaît pendant que vous parlez — sur cet appareil."
          }

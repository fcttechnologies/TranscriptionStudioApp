    "Read a transcript aloud with the on-device voice in Transcription Studio. Defaults to your latest transcript." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest ein Transkript mit der Stimme auf dem Gerät in Transcription Studio laut vor. Verwendet standardmäßig dein neuestes Transkript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee una transcripción en voz alta con la voz en el dispositivo en Transcription Studio. Usa tu transcripción más reciente de forma predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit une transcription à voix haute avec la voix sur l'appareil dans Transcription Studio. Utilise par défaut votre dernière transcription."

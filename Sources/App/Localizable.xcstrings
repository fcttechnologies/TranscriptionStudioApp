    "%@ is your currently selected model. Deleting it frees %@ and it will re-download automatically the next time it's needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist dein aktuell ausgewähltes Modell. Wenn du es löschst, wird %2$@ frei, und es wird automatisch erneut heruntergeladen, sobald es wieder benötigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is your currently selected model. Deleting it frees %2$@ and it will re-download automatically the next time it's needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es tu modelo seleccionado actualmente. Eliminarlo libera %2$@ y se volverá a descargar automáticamente la próxima vez que se necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est votre modèle actuellement sélectionné. Le supprimer libère %2$@ et il sera retéléchargé automatiquement la prochaine fois qu'il sera nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è il modello attualmente selezionato. Eliminarlo libera %2$@ e verrà scaricato di nuovo automaticamente la prossima volta che sarà necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は現在選択中のモデルです。削除すると%2$@の空き容量が確保され、次回必要になったときに自動的に再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 현재 선택된 모델입니다. 삭제하면 %2$@의 공간이 확보되며, 다음에 필요할 때 자동으로 다시 다운로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ é o modelo selecionado atualmente. Excluí-lo libera %2$@, e ele será baixado novamente de forma automática na próxima vez que for necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — выбранная сейчас модель. Удаление освободит %2$@, и модель автоматически загрузится снова, когда понадобится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 是您当前选用的模型。删除后将释放 %2$@ 的空间，下次需要时会自动重新下载。"
          }
        }
      }
    },
    "%@ used on this device. Deleting a model frees the space — it downloads again automatically the next time it's needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf diesem Gerät belegt. Ein gelöschtes Modell gibt den Speicherplatz frei — es wird beim nächsten Bedarf automatisch erneut heruntergeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usado en este dispositivo. Eliminar un modelo libera el espacio — se descarga de nuevo automáticamente la próxima vez que se necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilisé sur cet appareil. Supprimer un modèle libère l'espace — il se retélécharge automatiquement la prochaine fois qu'il est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilizzati su questo dispositivo. Eliminare un modello libera spazio — verrà scaricato di nuovo automaticamente la prossima volta che sarà necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで%@使用中です。モデルを削除すると空き容量が確保されます。次回必要になったときに自動的に再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 %@ 사용 중입니다. 모델을 삭제하면 공간이 확보됩니다. 다음에 필요할 때 자동으로 다시 다운로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usados neste dispositivo. Excluir um modelo libera o espaço — ele é baixado novamente automaticamente na próxima vez que for necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ занято на этом устройстве. Удаление модели освобождает место — она снова загрузится автоматически, когда понадобится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上已使用 %@。删除模型即可释放空间，下次需要时会自动重新下载。"
          }
        }
      }
    },

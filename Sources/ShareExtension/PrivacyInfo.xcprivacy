<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share extension's own manifest: a bundle's required-reason declarations never inherit
	     from the app that embeds it, so this declares for the appex alone. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Nothing collected here. The extension stages the shared file or link into the App Group
	     drop box (`IngestDropBox`) and returns; it links no sync engine and opens no network
	     connection, so it transmits nothing. Whatever it stages is collected later, by the app,
	     under the app's manifest. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- No required reason API. The extension's whole source membership is Foundation-only —
	     `ShareViewController` plus `Sources/App/SharedItems` — and it links no package, so nothing
	     in this bundle touches user defaults, file timestamps, disk space, system boot time or the
	     active-keyboards list. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>

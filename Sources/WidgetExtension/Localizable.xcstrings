    "Open Transcription Studio and start dictating. Your words come back as clean text." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Transcription Studio und startet das Diktat. Deine Worte kommen als sauberer Text zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Transcription Studio y empieza a dictar. Tus palabras vuelven como texto limpio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
